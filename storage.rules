rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // User profile pictures
    match /users/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Community post images from camera or gallery
    match /community/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.size < 15 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Song audio tracks and rehearsal recordings
    match /audios/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.size < 35 * 1024 * 1024
        && request.resource.contentType.matches('audio/.*');
    }

    // Default: public read for shared worship assets, deny unknown writes
    match /{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }
  }
}

