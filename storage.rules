rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Photos: User-isolated upload folder
    match /photos/{userId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    match /foto/{userId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    match /fotos/{userId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Videos: User-isolated upload folder
    match /videos/{userId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    match /video/{userId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Audio: User-isolated upload folder
    match /audio/{userId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    match /audios/{userId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // User profile pictures legacy path
    match /users/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Community post images legacy path
    match /community/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.size < 15 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Song audio tracks legacy path
    match /audios/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.size < 35 * 1024 * 1024
        && request.resource.contentType.matches('audio/.*');
    }

    // Default: public read for shared worship assets, deny unknown writes
    match /{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }
  }
}


