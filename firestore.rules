rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.role == 'admin' ||
        request.auth.token.admin == true ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Users Collection: public profile reading, owner or admin profile update
    match /users/{userId} {
      allow read: if true;
      allow create: if isAuthenticated() && (isOwner(userId) || isAdmin()) && (!('role' in request.resource.data) || request.resource.data.role != 'admin' || isAdmin());
      allow update: if isAuthenticated() && (
        isAdmin() ||
        (isOwner(userId) && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role'])))
      );
      allow delete: if isOwner(userId) || isAdmin();
    }

    // Admins Collection: server-side authority registry
    match /admins/{adminId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Songs Collection: professional music database with strict RBAC & moderation
    match /songs/{songId} {
      allow read: if (resource.data.status == 'published' && resource.data.visibility == 'public') ||
                     (isAuthenticated() && (resource.data.createdBy == request.auth.uid || isAdmin()));

      allow create: if isAuthenticated() && 
                    request.resource.data.createdBy == request.auth.uid &&
                    (isAdmin() || (
                      request.resource.data.status in ['draft', 'pendingReview'] &&
                      request.resource.data.visibility in ['private', 'unlisted'] &&
                      (!('verified' in request.resource.data) || request.resource.data.verified == false) &&
                      (!('verificationStatus' in request.resource.data) || request.resource.data.verificationStatus == 'unverified') &&
                      (!('verifiedBy' in request.resource.data) || request.resource.data.verifiedBy == null) &&
                      (!('sourceType' in request.resource.data) || request.resource.data.sourceType != 'official')
                    ));

      allow update: if isAuthenticated() && (
        isAdmin() ||
        (
          resource.data.createdBy == request.auth.uid &&
          request.resource.data.createdBy == resource.data.createdBy &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'createdBy', 'createdAt', 'verified', 'verifiedBy', 'verificationStatus', 'sourceType', 'source', 'status', 'visibility', 'version'
          ])
        )
      );

      allow delete: if isAuthenticated() && (resource.data.createdBy == request.auth.uid || isAdmin());
    }

    // Artists Catalog: public read, admin write
    match /artists/{artistId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Albums Catalog: public read, admin write
    match /albums/{albumId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Genres Catalog: public read, admin write
    match /genres/{genreId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Song Versions (Audit History): readable by author/admin, creator can append, admin can manage
    match /songVersions/{versionId} {
      allow read: if isAuthenticated() && (
        resource.data.createdBy == request.auth.uid ||
        isAdmin() ||
        (
          exists(/databases/$(database)/documents/songs/$(resource.data.songId)) &&
          get(/databases/$(database)/documents/songs/$(resource.data.songId)).data.createdBy == request.auth.uid
        )
      );
      allow create: if isAuthenticated() &&
        request.resource.data.createdBy == request.auth.uid &&
        ('songId' in request.resource.data) &&
        exists(/databases/$(database)/documents/songs/$(request.resource.data.songId)) &&
        (
          isAdmin() ||
          (
            get(/databases/$(database)/documents/songs/$(request.resource.data.songId)).data.createdBy == request.auth.uid &&
            (!('verified' in request.resource.data) || request.resource.data.verified == false) &&
            (!('verificationStatus' in request.resource.data) || request.resource.data.verificationStatus == 'unverified') &&
            (!('isOfficial' in request.resource.data) || request.resource.data.isOfficial == false) &&
            (!('status' in request.resource.data) || request.resource.data.status in ['draft', 'pendingReview'])
          )
        );
      allow update, delete: if isAdmin();
    }

    // Song Collections: public playlists readable by all, owner or admin can update
    match /songCollections/{collectionId} {
      allow read: if resource.data.visibility == 'public' || (isAuthenticated() && (resource.data.ownerId == request.auth.uid || isAdmin()));
      allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isAuthenticated() && (resource.data.ownerId == request.auth.uid || isAdmin());
    }

    // User Favorites: strictly isolated per user
    match /userFavorites/{favoriteId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow update: if false;
    }

    // User Song Playback History: strictly isolated per user
    match /userSongHistory/{historyId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow update: if false;
    }

    // Song Ratings & Reviews: public read, user manages own rating
    match /songRatings/{ratingId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Bands Collection: owner and members access control
    match /bands/{bandId} {
      allow read: if true;
      allow create: if isAuthenticated() && (
        request.resource.data.adminId == request.auth.uid ||
        request.resource.data.ownerId == request.auth.uid
      );
      allow update: if isAuthenticated() && (
        resource.data.adminId == request.auth.uid ||
        resource.data.ownerId == request.auth.uid ||
        (resource.data.members is list && request.auth.uid in resource.data.members) ||
        isAdmin()
      );
      allow delete: if isAuthenticated() && (
        resource.data.adminId == request.auth.uid ||
        resource.data.ownerId == request.auth.uid ||
        isAdmin()
      );
    }

    // Posts Collection: community posts readable by all, author or admin can delete, authenticated users can like or increment metrics
    match /posts/{postId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.authorId == request.auth.uid;
      allow update: if isAuthenticated() && (
        resource.data.authorId == request.auth.uid ||
        request.resource.data.diff(resource.data).affectedKeys().hasAny(['likes', 'likesCount', 'commentsCount', 'savesCount', 'updatedAt'])
      );
      allow delete: if isAuthenticated() && (resource.data.authorId == request.auth.uid || isAdmin());
    }

    // Comments Collection: comments attached to community posts
    match /comments/{commentId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.authorId == request.auth.uid && request.resource.data.content.size() <= 500;
      allow update: if isAuthenticated() && resource.data.authorId == request.auth.uid && request.resource.data.content.size() <= 500;
      allow delete: if isAuthenticated() && (resource.data.authorId == request.auth.uid || isAdmin());
    }

    // Follows Collection: musician follow relations
    match /follows/{followId} {
      allow read: if true;
      allow create: if isAuthenticated() && 
                    request.resource.data.followerId == request.auth.uid && 
                    request.resource.data.followerId != request.resource.data.followingId;
      allow delete: if isAuthenticated() && resource.data.followerId == request.auth.uid;
      allow update: if false;
    }

    // Band Invites Collection: invitations to join a band
    match /bandInvites/{inviteId} {
      allow read: if isAuthenticated() && (
        resource.data.targetUid == request.auth.uid ||
        resource.data.senderUid == request.auth.uid ||
        isAdmin()
      );
      allow create: if isAuthenticated() && request.resource.data.senderUid == request.auth.uid;
      allow update: if isAuthenticated() && (
        resource.data.targetUid == request.auth.uid ||
        resource.data.senderUid == request.auth.uid ||
        isAdmin()
      );
      allow delete: if isAuthenticated() && (
        resource.data.senderUid == request.auth.uid ||
        isAdmin()
      );
    }

    // Reports Collection: content moderation flags (only readable and resolvable by admins)
    match /reports/{reportId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated() && request.resource.data.reporterId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // Rehearsals Collection: setlists and rehearsals (private to creator, band members, or admin)
    match /rehearsals/{rehearsalId} {
      allow read: if isAuthenticated() && (
        resource.data.ownerId == request.auth.uid ||
        resource.data.createdBy == request.auth.uid ||
        (resource.data.members is list && request.auth.uid in resource.data.members) ||
        (resource.data.bandMemberUids is list && request.auth.uid in resource.data.bandMemberUids) ||
        (resource.data.allowedUsers is list && request.auth.uid in resource.data.allowedUsers) ||
        isAdmin()
      );
      allow create: if isAuthenticated() && (
        request.resource.data.ownerId == request.auth.uid ||
        request.resource.data.createdBy == request.auth.uid
      );
      allow update, delete: if isAuthenticated() && (
        resource.data.ownerId == request.auth.uid ||
        resource.data.createdBy == request.auth.uid ||
        isAdmin()
      );
    }

    // Missions Collection: worship ministry missions with RBAC & Live Sync
    match /missions/{missionId} {
      allow read: if isAuthenticated() && (
        isAdmin() ||
        resource.data.pastorId == request.auth.uid ||
        resource.data.leaderId == request.auth.uid ||
        (resource.data.members is list) // members of the ministry can view mission
      );

      allow create: if isAuthenticated() && (
        isAdmin() ||
        request.resource.data.pastorId == request.auth.uid ||
        request.resource.data.leaderId == request.auth.uid
      );

      allow update: if isAuthenticated() && (
        isAdmin() ||
        resource.data.pastorId == request.auth.uid ||
        resource.data.leaderId == request.auth.uid ||
        // Músico pode atualizar somente seu próprio check-in ou progresso de estudo
        request.resource.data.diff(resource.data).affectedKeys().hasAny(['members', 'progress', 'updatedAt', 'currentSongId', 'currentKey', 'currentBpm'])
      );

      allow delete: if isAuthenticated() && (
        isAdmin() ||
        resource.data.pastorId == request.auth.uid ||
        resource.data.leaderId == request.auth.uid
      );
    }

    // Virtuo Academy Collections: courses, modules, lessons and user progress
    match /academy_courses/{courseId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /academy_modules/{moduleId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /academy_lessons/{lessonId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /user_academy_progress/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow create, update: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
    }

    // Default deny all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
