# =============================================================
# VIRTUO - ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# =============================================================

# Server Port (Default: 3000)
PORT=3000

# Node Environment ('development' | 'production')
NODE_ENV=development

# Google Gemini API Key (Required on backend for AI Musical Director Davi)
# Note: Keep this secret; never expose it in client code or frontend bundles.
GEMINI_API_KEY=your_gemini_api_key_here

# Firebase Configuration
# Public web credentials are automatically read from firebase-applet-config.json
